# Frontend build-time configuration (Vite inlines VITE_* at build time).
# Copy to .env.local for local development. Every value here ends up in the
# public JS bundle — never put secrets (service-role keys etc.) in VITE_* vars.

# Supabase project URL (Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — safe to expose; access is enforced by RLS / the API.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend API base URL, no trailing slash.
VITE_API_URL=http://localhost:8000
