# syntax=docker/dockerfile:1

# ── Stage 1: build the Vite SPA ───────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
# Newer corepack avoids stale pnpm signing keys bundled with older Node images.
RUN npm install -g corepack@latest \
 && corepack enable \
 && corepack prepare pnpm@10.34.3 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Vite inlines these at build time; Railway passes service variables as build args.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_API_URL=$VITE_API_URL

RUN test -n "$VITE_SUPABASE_URL" && test -n "$VITE_SUPABASE_PUBLISHABLE_KEY" && test -n "$VITE_API_URL" \
 || (echo "ERROR: VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY and VITE_API_URL must be set as build args" >&2 && exit 1)

# Sources (index.html, vite.config.ts, src/, public/, .figma/make/site.json …);
# .dockerignore keeps backend/, supabase/, secrets and node_modules out.
COPY . .
RUN pnpm build

# ── Stage 2: serve with Caddy ────────────────────────────────────────────────
FROM caddy:2-alpine

# Used by the Caddyfile's Content-Security-Policy (connect-src).
ARG VITE_SUPABASE_URL
ARG VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_API_URL=$VITE_API_URL \
    PORT=8080

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
